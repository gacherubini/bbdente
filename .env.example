DATABASE_URL=postgresql+psycopg://bddente:bddente@localhost:5432/bddente
DATABASE_URL_TESTE=postgresql+psycopg://bddente:bddente@localhost:5432/bddente_teste
SECRET_KEY=gere-com-python-c-import-secrets-print-secrets-token-hex-32
SESSAO_HORAS=12
COOKIE_SEGURO=false
CLINICA_ID_PADRAO=1
EXTRATO_SQLITE=dados_extraidos/dentalis.sqlite

# Segredo do gatilho manual `POST /tarefas/lembretes`. Vazio (o padrao) faz o
# endereco responder 404 para todo mundo — nao pode existir uma porta que
# qualquer um abre mandando o cabecalho vazio. Quem dispara no dia a dia e o
# relogio dentro do app; isto aqui e o gatilho de emergencia.
TAREFAS_TOKEN=

# Porta publicada pelo Postgres local (docker-compose). Mude se a 5432 ja estiver
# ocupada por outro projeto na sua maquina — e ajuste as URLs acima junto.
DB_PORT=5432
