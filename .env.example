DATABASE_URL=postgresql+psycopg://bddente:bddente@localhost:5432/bddente
DATABASE_URL_TESTE=postgresql+psycopg://bddente:bddente@localhost:5432/bddente_teste
SECRET_KEY=gere-com-python-c-import-secrets-print-secrets-token-hex-32
SESSAO_HORAS=12
COOKIE_SEGURO=false
CLINICA_ID_PADRAO=1
EXTRATO_SQLITE=dados_extraidos/dentalis.sqlite

# Segredo do gatilho manual `POST /tarefas/lembretes`. Vazio (o padrao) faz o
# endereco responder 404 para todo mundo — nao pode existir uma porta que
# qualquer um abre mandando o cabecalho vazio. Quem dispara no dia a dia e o
# relogio dentro do app; isto aqui e o gatilho de emergencia.
TAREFAS_TOKEN=

# Por onde a mensagem sai. "fake" registra o que enviaria e nao fala com ninguem;
# "evolution" fala com o WhatsApp de verdade. O padrao e o de mentira, e isso e a
# barreira: ligar o envio real e um ato deliberado, nunca o resultado de esquecer
# de configurar. Errar o nome aqui, ou deixar a chave vazia, tambem cai no fake.
WHATSAPP_PROVEDOR=fake
# A Evolution roda como app separado no Fly, alcancada pela rede PRIVADA. Sem
# endereco publico de proposito: ela nao tem login, so esta chave de cabecalho —
# um endereco publico seria uma porta para o WhatsApp da dentista.
EVOLUTION_URL=http://bddente-whatsapp.internal:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=bddente
EVOLUTION_TIMEOUT_S=10

# Porta publicada pelo Postgres local (docker-compose). Mude se a 5432 ja estiver
# ocupada por outro projeto na sua maquina — e ajuste as URLs acima junto.
DB_PORT=5432
